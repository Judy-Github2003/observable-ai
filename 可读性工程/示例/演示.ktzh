// 注释里的中文不动：如果这里被改了，说明状态机坏了。
函数 判定(年龄: Int): String {
    如果 (年龄 > 18) {
        返回 "成年"。
    } 否则 {
        返回 "未成年"。
    }
}

函数 main() {
    值 数字 = listOf(12, 20, 30)。
    遍历 (项 在 数字) {
        println(判定(项))。
    }

    值 等级 = 当 (数字.size) {
        0 -> "空"。
        否则 -> "有货"。
    }。
    println(等级)。

    变量 计数 = 0。
    只要 (计数 < 2) {
        计数 += 1。
    }。
    println("循环次数：${计数}")。
}
